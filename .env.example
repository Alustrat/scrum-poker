# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# Server
PORT=3001

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=scrum_poker

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cors
CLIENT_ORIGIN=*

# Abuse / capacity limits (all optional, defaults shown)
# MAX_ROOMS=1000
# MAX_PARTICIPANTS_PER_ROOM=20
# MAX_SOCKETS_PER_PARTICIPANT=5
# MAX_ROOM_CREATIONS_PER_HOUR=20
