# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# Server
PORT=3001

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=scrum_poker

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cors
CLIENT_ORIGIN=*
