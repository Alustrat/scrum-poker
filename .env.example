# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# Server
PORT=3001

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=scrum_poker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cors
CLIENT_ORIGIN=*
